LANGSMITH_API_KEY=

# GIGA_AGENT SETTINGS
GIGA_AGENT_LLM=openai:gpt-4o
GIGA_AGENT_LLM_FAST=openai:gpt-4o-mini
GIGA_AGENT_EMBEDDINGS=openai:text-embedding-3-small
GIGA_AGENT_SENTIMENT_MODEL=models/sentiment_openai.joblib
GIGA_AGENT_LANG=en-US
IMAGE_GEN_NAME=openai:dall-e-2
IMAGE_GEN_PARALLEL=5

# REQUIRED OPENAI SETTINGS
OPENAI_API_KEY=

## SERVICES
TAVILY_API_KEY=
VK_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
OWM_API_KEY=

# CLOUD EMBEDDINGS API (для lawyer_agent)
# Используются для векторного поиска в юридическом агенте
# Приоритет: HUGGINGFACE_API_KEY > COHERE_API_KEY > OPENAI_API_KEY
# Если ни один ключ не установлен, используются локальные модели

# Hugging Face Token (универсальный для STT и Embeddings API)
# Используется для: загрузки моделей STT из Hugging Face Hub и для Embeddings API
# Получить ключ: https://huggingface.co/settings/tokens
# Модель по умолчанию: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_TOKEN=
# Альтернативные переменные (для обратной совместимости):
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_HUB_TOKEN=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Cohere Embed API (бесплатно до 1000 запросов/месяц)
# Получить ключ: https://dashboard.cohere.com/api-keys
# Модель по умолчанию: embed-multilingual-v3.0
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0

# OpenAI Embeddings API (платно, но дешево: $0.00002/1K токенов)
# Получить ключ: https://platform.openai.com/api-keys
# Модель по умолчанию: text-embedding-3-small
# Примечание: Если OPENAI_API_KEY уже установлен выше, он будет использован и для эмбеддингов
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AI PROXY SETTINGS (для OpenAI API через прокси)
# Используется для OpenAI Embeddings API, если требуется работа через прокси-сервер
AI_PROXY_HOST=
AI_PROXY_USERNAME=
AI_PROXY_PASSWORD=
AI_PROXY_PORT=8080

# EMBEDDINGS SERVICE (микросервис локальных эмбеддингов)
# URL микросервиса локальных эмбеддингов (по умолчанию: http://embeddings-service:9094)
# Если не установлен, система попытается использовать прямую загрузку локальных моделей
EMBEDDINGS_SERVICE_API=http://embeddings-service:9094
# Модель для локальных эмбеддингов (используется в микросервисе)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Устройство для вычислений (cpu или cuda)
EMBEDDING_DEVICE=cpu

# FUSION BRAIN (IMAGE GENERATION)
KANDINSKY_API_KEY=
KANDINSKY_SECRET_KEY=

TWOGIS_TOKEN=

SALUTE_SPEECH=
SBER_TTS_TIMEOUT=30

## INTERNAL STUFF
PLOTLY_RENDERER=plotly_mimetype
MAX_KERNEL_LIVE=300
FILES_DIR=files
LANGGRAPH_API_URL="http://langgraph-api:8000/"
JINA_READER_URL=https://r.jina.ai/
CHARACTER_LIMIT=100000
REPL_FROM_MESSAGE=0
